    "intro_follow_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Schedule, add a swimmer or a club with the filter {filter}: only their heats are listed.\n\nTurn on All heats to see every heat again.\n\nWhere the meet allows it, the bell {bell} at the top of Schedule tells you when their heat is near."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Programa, agregue un nadador o un club con el filtro {filter} y solo se listan sus series.\n\nActive Todas las series para volver a verlas todas.\n\nCuando la competición lo permite, la campana {bell} en la parte superior de Programa le avisa cuando su serie se acerca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Horaire, ajoutez un nageur ou un club avec le filtre {filter} : seules leurs séries sont listées.\n\nActivez Toutes les séries pour les revoir toutes.\n\nQuand la compétition le permet, la cloche {bell} en haut d'Horaire vous prévient quand leur série approche."
          }
        }
      }
    },
    "intro_follow_title" : {
      "extractionState" : "manual",

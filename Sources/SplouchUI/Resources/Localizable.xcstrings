    "intro_key_gap" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gap to the seed time: green when faster, grey when slower"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diferencia con el tiempo de inscripción: verde si es más rápido, gris si es más lento"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

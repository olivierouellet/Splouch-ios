    "intro_tabs_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scoreboard shows the heat in the water, Results the finished heats, and Schedule the start lists — all three along the bottom of a meet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marcador muestra la serie en el agua, Resultados las series terminadas y Programa las listas de salida — las tres en la parte inferior de una competencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tableau montre la série dans l'eau, Résultats les séries terminées et Horaire les listes de départ — les trois au bas de l'écran d'une compétition."
          }
        }
      }
    },

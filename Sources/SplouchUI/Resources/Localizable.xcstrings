    "intro_follow_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Schedule, add a swimmer or a club with the filter and only their heats are listed. Turn on All heats to see every heat again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Programa, agregue un nadador o un club con el filtro y solo se listan sus series. Active Todas las series para volver a verlas todas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Horaire, ajoutez un nageur ou un club avec le filtre : seules leurs séries sont listées. Activez Toutes les séries pour les revoir toutes."
          }
        }
      }

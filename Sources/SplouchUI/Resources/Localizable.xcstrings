    "intro_times_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each lane shows its seed time, then its console time once swum, then its official time, each in its own colour.\n\nTap a heat marked {plusminus} to see each lane's gap to its seed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada carril muestra su tiempo de inscripción, luego el tiempo de la consola una vez nadado y luego el tiempo oficial, cada uno con su color.\n\nToque una serie marcada con {plusminus} para ver la diferencia de cada carril con su inscripción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque couloir montre son temps d'inscription, puis le temps de la console une fois nagé, puis le temps officiel, chacun de sa couleur.\n\nTouchez une série marquée {plusminus} pour voir l'écart de chaque couloir avec son inscription."
          }
        }
      }
    },

    "intro_meets_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meets are listed by day.\n\nThe filter {filter} keeps only the meets of your club, country or province. It stays set until you clear it.\n\nThe gear {gear} opens Settings: language, appearance and privacy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las competiciones se listan por día.\n\nEl filtro {filter} deja solo las de su club, país o provincia. Queda activo hasta que lo borre.\n\nEl engranaje {gear} abre los Ajustes: idioma, apariencia y privacidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les compétitions sont classées par jour.\n\nLe filtre {filter} ne garde que celles de votre club, pays ou province. Il reste actif jusqu'à ce que vous l'effaciez.\n\nL'engrenage {gear} ouvre les Réglages : langue, apparence et confidentialité."
          }
        }
      }
    },
    "intro_meets_title" : {

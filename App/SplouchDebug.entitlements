<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug only. `?mode=developer` makes the device fetch the association file
	     from the domain directly instead of through Apple's CDN, which caches it for
	     hours — the difference between testing a change to the web half now and
	     testing it tomorrow. It needs Developer Mode and "Associated Domains
	     Development" on the device (Settings ▸ Developer); the simulator honours it
	     without either. The release entitlements file is the plain one.

	     app.md P-16: the QR code carries https://splouch.org/add?server=<origin>, and this
	     is what makes iOS hand that link to the app instead of Safari. The app's own
	     default server (P-11) — a universal link is verified
	     per domain against that host's /.well-known/apple-app-site-association, and
	     a pool's Pi has no https and no certificate, so the Pi travels in the query
	     and never in the authority. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:splouch.org?mode=developer</string>
	</array>
	<!-- app.md N-04 to N-08: heat notifications, sent by the meet's cloud node
	     through APNs. A debug build's token is the sandbox's (api.md §5.13). -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- A heat in five minutes is what Time Sensitive is for: it reaches the
	     spectator through a Focus they have not exempted the app from. The
	     server marks each alert `interruption-level: time-sensitive`. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug only. `?mode=developer` makes the device fetch the association file
	     from the domain directly instead of through Apple's CDN, which caches it for
	     hours — the difference between testing a change to the web half now and
	     testing it tomorrow. It needs Developer Mode and "Associated Domains
	     Development" on the device (Settings ▸ Developer); the simulator honours it
	     without either. The release entitlements file is the plain one.

	     app.md P-16: the QR code carries https://splouch.ca/add?server=<origin>, and
	     this is what makes iOS hand that link to the app instead of Safari. One
	     domain, the app's own default server (P-11) — a universal link is verified
	     per domain against that host's /.well-known/apple-app-site-association, and
	     a pool's Pi has no https and no certificate, so the Pi travels in the query
	     and never in the authority. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:splouch.ca?mode=developer</string>
	</array>
</dict>
</plist>
